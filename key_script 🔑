            MakeGui("TextLabel", {
                Text=name, TextColor3=White, TextSize=13, Font=Enum.Font.GothamBold,
                Position=UDim2.new(0,12,0,7), Size=UDim2.new(1,-24,0,20), BackgroundTransparency=1, Parent=card
            })
            MakeGui("TextLabel", {
                Text="CLICK ĐỂ ÁP DỤNG ✅", TextColor3=Color3.fromRGB(125,155,180), TextSize=9,
                Position=UDim2.new(0,12,0,29), Size=UDim2.new(1,-24,0,15), BackgroundTransparency=1, Parent=card
            })
            Connect(card.MouseEnter, function()
                TweenService:Create(card, TweenInfo.new(0.25), {BackgroundColor3=Color3.fromRGB(18,25,48)}):Play()
                border.Transparency = 0.05; border.Color = Cyan
            end)
            Connect(card.MouseLeave, function()
                TweenService:Create(card, TweenInfo.new(0.3), {BackgroundColor3=Color3.fromRGB(13,16,32)}):Play()
                border.Transparency = 0.3; border.Color = Color3.fromRGB(40,100,155)
            end)
            Connect(card.Activated, function() ApplyPack(name) end)
        end
    end
    task.defer(function() Content.CanvasSize = UDim2.new(0,0,0,ContentLayout.AbsoluteContentSize.Y + 20) end)
end

