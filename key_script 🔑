--==============================================================--
-- HELPERS
--==============================================================--

local function Corner(parent, radius)

    local c =
        Instance.new("UICorner")

    c.CornerRadius =
        UDim.new(
            0,
            radius or 12
        )

    c.Parent = parent

    return c

end

local function Stroke(
    parent,
    color,
    thickness,
    transparency
)

    local s =
        Instance.new("UIStroke")

    s.Color =
        color or Cyan

    s.Thickness =
        thickness or 1

    s.Transparency =
        transparency or 0

    s.Parent =
        parent

    return s

end

local function MakeText(
    parent,
    text,
    size,
    bold
)

    local t =
        Instance.new("TextLabel")

    t.BackgroundTransparency =
        1

    t.Text =
        text

    t.TextColor3 =
        White

    t.TextSize =
        size or 14

    t.Font =
        bold
        and Enum.Font.GothamBold
        or Enum.Font.Gotham

    t.TextXAlignment =
        Enum.TextXAlignment.Left

    t.Parent =
        parent

    return t

end

local function MakeButton(
    parent,
    text
)

    local b =
        Instance.new("TextButton")

    b.AutoButtonColor =
        false

    b.Text =
        text

    b.TextColor3 =
        White

    b.TextSize =
        12

    b.Font =
        Enum.Font.GothamMedium

    b.BackgroundColor3 =
        Card

    b.BackgroundTransparency =
        0.12

    b.BorderSizePixel =
        0

    b.Parent =
        parent

    Corner(
        b,
        10
    )

    Stroke(
        b,
        Color3.fromRGB(
            55,
            90,
            150
        ),
        1,
        0.35
    )

    return b

end

