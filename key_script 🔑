local Keo = false
local ViTriBatDau
local KhungBatDau

local function BatDauKeo(input)

    Keo = true
    ViTriBatDau = input.Position
    KhungBatDau = Khung.Position

    input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            Keo = false
        end
    end)
end

local function CapNhatKeo(input)

    if not Keo then
        return
    end

    local delta = input.Position - ViTriBatDau

    Khung.Position = UDim2.new(
        KhungBatDau.X.Scale,
        KhungBatDau.X.Offset + delta.X,
        KhungBatDau.Y.Scale,
        KhungBatDau.Y.Offset + delta.Y
    )
end

TieuDe.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        BatDauKeo(input)

    end

end)

TieuDe.InputChanged:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        CapNhatKeo(input)

    end

end)

