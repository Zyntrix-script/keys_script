local CurrentPackName = nil
local ApplyToken = 0

local function GetAnimate()

    local Character =
        Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild(
        "Animate"
    )

end

local function SetAnimation(
    parent,
    name,
    id
)

    if not parent or not id then
        return
    end

    local animation =
        parent:FindFirstChild(
            name
        )

    if not animation then

        animation =
            Instance.new(
                "Animation"
            )

        animation.Name =
            name

        animation.Parent =
            parent

    end

    pcall(function()

        animation.AnimationId =
            "rbxassetid://" ..
            tostring(id)

    end)

end

local function ApplyPack(
    packName
)

    local pack =
        AnimationPacks[
            packName
        ]

    if not pack then
        return
    end

    CurrentPackName =
        packName

    ApplyToken += 1

    local token =
        ApplyToken

    Status.Text =
        "APPLYING • " ..
        packName ..
        " "

    task.spawn(
        function()

            local retries = {
                0,
                0.15,
                0.35,
                0.7,
                1.2,
                2
            }

            for _, delayTime in ipairs(
                retries
            ) do

                if not Alive
                or token ~= ApplyToken then
                    return
                end

                if delayTime > 0 then
                    task.wait(delayTime)
                end

                local Animate =
                    GetAnimate()

                if Animate then

                    pcall(
                        function()

                            local walk =
                                Animate:FindFirstChild(
                                    "walk"
                                )

                            if walk then

                                SetAnimation(
                                    walk,
                                    "WalkAnim",
                                    pack.Walk
                                )

                            end

                            local run =
                                Animate:FindFirstChild(
                                    "run"
                                )

                            if run then

                                SetAnimation(
                                    run,
                                    "RunAnim",
                                    pack.Run
                                )

                            end

                            local jump =
                                Animate:FindFirstChild(
                                    "jump"
                                )

                            if jump then

                                SetAnimation(
                                    jump,
                                    "JumpAnim",
                                    pack.Jump
                                )

                            end

                            local fall =
                                Animate:FindFirstChild(
                                    "fall"
                                )

                            if fall then

                                SetAnimation(
                                    fall,
                                    "FallAnim",
                                    pack.Fall
                                )

                            end

                            local climb =
                                Animate:FindFirstChild(
                                    "climb"
                                )

                            if climb then

                                SetAnimation(
                                    climb,
                                    "ClimbAnim",
                                    pack.Climb
                                )

                            end

                            local swim =
                                Animate:FindFirstChild(
                                    "swim"
                                )

                            if swim then

                                SetAnimation(
                                    swim,
                                    "Swim",
                                    pack.Swim
                                )

                            end

                            local swimIdle =
                                Animate:FindFirstChild(
                                    "swimidle"
                                )

                            if swimIdle then

                                SetAnimation(
                                    swimIdle,
                                    "SwimIdle",
                                    pack.SwimIdle
                                )

                            end

                            local idle =
                                Animate:FindFirstChild(
                                    "idle"
                                )

                            if idle then

                                if pack.Idle1 then

                                    SetAnimation(
                                        idle,
                                        "Animation1",
                                        pack.Idle1
                                    )

                                end

                                if pack.Idle2 then

                                    SetAnimation(
                                        idle,
                                        "Animation2",
                                        pack.Idle2
                                    )

                                end

                            end

                        end
                    )

                    Status.Text =
                        "ACTIVE • " ..
                        packName ..
                        " "

                    return

                end

            end

            Status.Text =
                "RETRY • CHARACTER CHƯA SẴN SÀNG "

        end
    )

end

