local function TimHoacTao(parent, ten)
    local a = parent:FindFirstChild(ten)

    if not a then
        a = Instance.new("Animation")
        a.Name = ten
        a.Parent = parent
    end

    return a
end

local function DatAnimation(animate, ten, id)
    if not id then
        return
    end

    local obj = animate:FindFirstChild(ten, true)

    if obj and obj:IsA("Animation") then
        obj.AnimationId = "rbxassetid://" .. tostring(id)
        return
    end

    local folder = animate:FindFirstChild(ten)

    if folder and folder:IsA("Folder") then
        local a = folder:FindFirstChildWhichIsA("Animation", true)

        if a then
            a.AnimationId = "rbxassetid://" .. tostring(id)
        else
            local aMoi = Instance.new("Animation")
            aMoi.Name = "Animation"
            aMoi.AnimationId = "rbxassetid://" .. tostring(id)
            aMoi.Parent = folder
        end

        return
    end
end

local function ApDungGoi(tenGoi)
    local goi = GoiHoatHinh[tenGoi]
    if not goi then
        return false
    end

    local nhanVat = NguoiChoi.Character
    if not nhanVat then
        return false
    end

    local animate = nhanVat:FindFirstChild("Animate")

    if not animate then
        return false
    end

    -- Dừng animation cũ
    local humanoid = nhanVat:FindFirstChildOfClass("Humanoid")

    if humanoid then
        for _,track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            pcall(function()
                track:Stop(0.08)
            end)
        end
    end

    -- Gán animation
    DatAnimation(animate,"walk",goi.Walk)
    DatAnimation(animate,"run",goi.Run)
    DatAnimation(animate,"jump",goi.Jump)
    DatAnimation(animate,"fall",goi.Fall)
    DatAnimation(animate,"climb",goi.Climb)
    DatAnimation(animate,"swim",goi.Swim)
    DatAnimation(animate,"swimidle",goi.SwimIdle)
    DatAnimation(animate,"idle",goi.Idle1)

    -- Một số Animate dùng idle/Animation1 + Animation2
    local idle = animate:FindFirstChild("idle")

    if idle and goi.Idle1 then
        local a = idle:FindFirstChild("Animation1")

        if a and a:IsA("Animation") then
            a.AnimationId = "rbxassetid://" .. tostring(goi.Idle1)
        end
    end

    if idle and goi.Idle2 then
        local a = idle:FindFirstChild("Animation2")

        if a and a:IsA("Animation") then
            a.AnimationId = "rbxassetid://" .. tostring(goi.Idle2)
        end
    end

    -- Khởi động lại Animate
    pcall(function()
        animate.Disabled = true
        task.wait()
        animate.Disabled = false
    end)

    GoiDangChon = tenGoi

    return true
end

