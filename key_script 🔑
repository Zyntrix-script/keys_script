--========================================================--
-- DOOR DATABASE
--========================================================--

local Doors = {}
local OpenedDoors = {}
local KeyCollected = false

local function clearDoorDatabase()
    table.clear(Doors)
end

local function getDoorPart(obj)
    if not obj then return nil end

    if obj:IsA("BasePart") then
        return obj
    end

    local names = {
        "ControlPart",
        "DoorLeft",
        "DoorRight",
        "PrimaryPart",
        "Handle",
    }

    for _, name in ipairs(names) do
        local p = obj:FindFirstChild(name, true)
        if p and p:IsA("BasePart") then
            return p
        end
    end

    return obj:FindFirstChildWhichIsA("BasePart", true)
end

--========================================================--
-- DOOR OPEN DETECTOR
--========================================================--

local function isDoorOpened(door)
    if not door or not door.Parent then
        return true
    end

    local attrs = {
        "Opened",
        "IsOpened",
        "Open",
        "OpenedDoor",
        "DoorOpened",
        "Unlocked",
        "Used",
        "Activated",
    }

    for _, attr in ipairs(attrs) do
        local value = door:GetAttribute(attr)

        if value == true then
            return true
        end
    end

    local prompt = door:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt then
        if prompt.Enabled == false then
            return true
        end
    end

    local boolNames = {
        "Opened",
        "IsOpened",
        "Open",
        "Unlocked",
        "Used",
    }

    for _, name in ipairs(boolNames) do
        local value = door:FindFirstChild(name, true)

        if value and value:IsA("BoolValue") then
            if value.Value == true then
                return true
            end
        end
    end

    return OpenedDoors[door] == true
end

--========================================================--
-- FIND DOORS
--========================================================--

local function scanAllDoors()
    clearDoorDatabase()

    local maps = Workspace:FindFirstChild("Maps")

    if not maps then
        return 0
    end

    for _, map in ipairs(maps:GetChildren()) do

        for _, obj in ipairs(map:GetDescendants()) do

            local n = string.lower(obj.Name)

            if n == "door"
                or n == "doorleft"
                or n == "doorright"
                or string.find(n, "door", 1, true)
            then

                local door = obj

                if obj:IsA("BasePart") and obj.Parent then
                    door = obj.Parent
                end

                local part = getDoorPart(door)

                if part then

                    local exists = false

                    for existing in pairs(Doors) do
                        if existing == door then
                            exists = true
                            break
                        end
                    end

                    if not exists then
                        Doors[door] = {
                            Part = part
                        }
                    end
                end
            end
        end
    end

    return #({})
end

--========================================================--
-- KEY FINDER
--========================================================--

local function findKey()
    local maps = Workspace:FindFirstChild("Maps")

    if not maps then
        return nil
    end

    for _, obj in ipairs(maps:GetDescendants()) do
        if KEY_NAMES[obj.Name] then
            local part = getDoorPart(obj)

            if part then
                return obj, part
            end
        end
    end

    -- fallback full Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if KEY_NAMES[obj.Name] then
            local part = getDoorPart(obj)

            if part then
                return obj, part
            end
        end
    end

    return nil
end

--========================================================--
-- FAST PROXIMITY
--========================================================--

local function firePrompt(prompt)
    if not prompt then
        return false
    end

    local ok = false

    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
            ok = true
        end
    end)

    return ok
end

local function interactAt(part)
    if not part then
        return false
    end

    local prompt = part:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if not prompt then
        prompt = part.Parent
            and part.Parent:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            )
    end

    if not prompt then
        return false
    end

    return firePrompt(prompt)
end

--========================================================--
-- TELEPORT
--========================================================--

local function teleportTo(part)
    local root = getRoot()

    if not root or not part then
        return false
    end

    pcall(function()
        root.CFrame =
            part.CFrame *
            CFrame.new(0, 0, -TELEPORT_OFFSET)
    end)

    return true
end

--========================================================--
-- COUNT
--========================================================--

local function getCounts()
    local total = 0
    local opened = 0

    for door in pairs(Doors) do

        if not door or not door.Parent then
            Doors[door] = nil
        else
            total += 1

            if isDoorOpened(door) then
                OpenedDoors[door] = true
                opened += 1
            end
        end
    end

    return total, opened
end

--========================================================--
-- UI UPDATE
--========================================================--

local function updateDoorUI()
    local total, opened = getCounts()

    local unopened = math.max(total - opened, 0)

    DoorInfo.Text =
        "🚪 DOOR : " ..
        tostring(unopened) ..
        " CHƯA MỞ / " ..
        tostring(total)

    OpenInfo.Text =
        "✓ OPENED : " ..
        tostring(opened)

    local percent = 0

    if total > 0 then
        percent = math.floor(
            (opened / total) * 100
        )
    end

    Percent.Text = percent .. "%"

    tween(
        Bar,
        0.15,
        {
            Size = UDim2.new(
                percent / 100,
                0,
                1,
                0
            )
        }
    )

    if percent >= 100 and total > 0 then

        Bar.BackgroundColor3 = C.GREEN
        Percent.TextColor3 = C.GREEN

        Status.Text = "FARM COMPLETE"
        Status.TextColor3 = C.GREEN
        StatusDot.BackgroundColor3 = C.GREEN

    else

        Bar.BackgroundColor3 = C.CYAN
        Percent.TextColor3 = C.CYAN

    end
end

--========================================================--
-- KEY FARM
--========================================================--

local function farmKey()

    KeyInfo.Text = "🔑 KEY : SEARCHING..."
    KeyInfo.TextColor3 = C.YELLOW

    local key, part = findKey()

    if not key or not part then
        KeyInfo.Text = "🔑 KEY : NOT FOUND"
        KeyInfo.TextColor3 = C.RED
        return false
    end

    KeyInfo.Text = "🔑 KEY : FOUND"

    Status.Text = "MOVING TO KEY"
    Status.TextColor3 = C.CYAN
    StatusDot.BackgroundColor3 = C.CYAN

    teleportTo(part)

    task.wait(AUTO_DELAY)

    local success = interactAt(part)

    if success then
        KeyCollected = true
        KeyInfo.Text = "🔑 KEY : COLLECTED"
        KeyInfo.TextColor3 = C.GREEN
    else
        KeyInfo.Text = "🔑 KEY : INTERACT FAILED"
        KeyInfo.TextColor3 = C.RED
    end

    return success
end

--========================================================--
-- FARM ONE DOOR
--========================================================--

local function farmDoor(door, data)

    if not door
        or not door.Parent
        or not data
        or not data.Part
    then
        return false
    end

    -- Kiểm tra lại ngay trước khi teleport
    if isDoorOpened(door) then
        OpenedDoors[door] = true
        return false
    end

    Status.Text = "MOVING TO DOOR"
    Status.TextColor3 = C.CYAN
    StatusDot.BackgroundColor3 = C.CYAN

    teleportTo(data.Part)

    task.wait(AUTO_DELAY)

    -- kiểm tra lần 2
    if isDoorOpened(door) then
        OpenedDoors[door] = true
        return true
    end

    local success = interactAt(data.Part)

    if success then
        task.wait(0.08)

        -- Người khác hoặc server có thể cập nhật trạng thái trễ
        if isDoorOpened(door) then
            OpenedDoors[door] = true
        else
            -- đánh dấu tạm thời, nhưng vòng scan sau vẫn kiểm tra lại
            OpenedDoors[door] = true
        end

        return true
    end

    return false
end

--========================================================--
-- AUTO FARM
--========================================================--

local AutoFarmEnabled = false
local Farming = false

local function autoFarmLoop()

    if Farming then
        return
    end

    Farming = true

    while AutoFarmEnabled do

        --==============================================--
        -- KEY
        --==============================================--

        if not KeyCollected then
            farmKey()
            task.wait(0.15)
        end

        --==============================================--
        -- SCAN DOORS
        --==============================================--

        scanAllDoors()
        updateDoorUI()

        local total, opened = getCounts()

        if total == 0 then
            Status.Text = "SEARCHING DOORS"
            Status.TextColor3 = C.CYAN
            StatusDot.BackgroundColor3 = C.CYAN

            task.wait(DOOR_SCAN_DELAY)
            continue
        end

        if opened >= total then
            Status.Text = "FARM COMPLETE"
            Status.TextColor3 = C.GREEN
            StatusDot.BackgroundColor3 = C.GREEN

            task.wait(0.5)

            -- scan lại để bắt cửa mới spawn
            scanAllDoors()
            updateDoorUI()

            local newTotal, newOpened = getCounts()

            if newTotal > newOpened then
                continue
            end

            break
        end

        --==============================================--
        -- FIND UNOPENED DOOR
        --==============================================--

        local targetDoor = nil
        local targetData = nil

        local nearestDistance = math.huge
        local root = getRoot()

        for door, data in pairs(Doors) do

            if door.Parent
                and data.Part
                and not isDoorOpened(door)
            then

                local distance = 0

                if root then
                    distance =
                        (
                            root.Position -
                            data.Part.Position
                        ).Magnitude
                end

                if distance < nearestDistance then
                    nearestDistance = distance
                    targetDoor = door
                    targetData = data
                end
            end
        end

        --==============================================--
        -- FARM TARGET
        --==============================================--

        if targetDoor and targetData then

            local ok = farmDoor(
                targetDoor,
                targetData
            )

            if ok then
                Status.Text = "DOOR INTERACTED"
                Status.TextColor3 = C.GREEN
                StatusDot.BackgroundColor3 = C.GREEN
            end

            -- cực quan trọng:
            -- scan lại toàn bộ để nhận cửa người khác mở
            task.wait(0.10)

            scanAllDoors()
            updateDoorUI()

        else
            task.wait(DOOR_SCAN_DELAY)
        end

        task.wait(0.05)
    end

    Farming = false
end

