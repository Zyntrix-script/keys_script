--                  HÀM TẠO VIỀN CHẠY
--============================================================--

local function TaoVienChay(obj, doDay)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = doDay or 1.5
    stroke.Transparency = 0.05
    stroke.Color = MÀU_TÍM
    stroke.Parent = obj

    task.spawn(function()
        local t = 0

        while stroke.Parent do
            t += 0.012

            local r = (math.sin(t) + 1) / 2
            local g = (math.sin(t + 2) + 1) / 2
            local b = (math.sin(t + 4) + 1) / 2

            stroke.Color = Color3.new(r, g, b)

            task.wait()
        end
    end)

    return stroke
end

