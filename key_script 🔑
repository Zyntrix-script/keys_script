--========================================================--

local Dragging = false
local DragStart
local StartPosition

TopBar.InputBegan:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.Touch
        or Input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        Dragging = true
        DragStart = Input.Position
        StartPosition = Main.Position

        Input.Changed:Connect(function()

            if Input.UserInputState ==
                Enum.UserInputState.End then

                Dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end

    if Input.UserInputType ==
        Enum.UserInputType.Touch
        or Input.UserInputType ==
        Enum.UserInputType.MouseMovement then

        local Delta =
            Input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end
end)

--========================================================--
-- RESPAWN FIX
--========================================================--

local RespawnToken = 0

LP.CharacterAdded:Connect(function(Character)

    RespawnToken += 1

    local Token = RespawnToken
    local SavedPack = CurrentPack

    if not SavedPack then
        return
    end

    task.spawn(function()

        local Humanoid =
            Character:WaitForChild(
                "Humanoid",
                8
            )

        if not Humanoid
        or Token ~= RespawnToken then
            return
        end

        local Animate

        for _ = 1,80 do

            if Token ~= RespawnToken then
                return
            end

            if not Character.Parent then
                return
            end

            Animate =
                Character:FindFirstChild("Animate")

            if Animate then
                break
            end

            task.wait(0.1)
        end

        if not Animate then
            return
        end

        if CurrentPack == SavedPack then
            applyPack(SavedPack)
            refreshButtons()
        end

        for _,DelayTime in ipairs({
            0.15,
            0.40,
            0.80,
            1.30
        }) do

            task.wait(DelayTime)

            if Token ~= RespawnToken then
                return
            end

            if not Character.Parent then
                return
            end

            if CurrentPack == SavedPack then
                applyPack(SavedPack)
                refreshButtons()
            end
        end
    end)
end)

