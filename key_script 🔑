local function DestroyPlayerESP(player)
    local data = TrackedPlayers[player]
    if not data then return end
    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end
    TrackedPlayers[player] = nil
end

local function CreatePlayerESP(player)
    if not PlayerEspEnabled or player == LocalPlayer or TrackedPlayers[player] then return end

    local character = player.Character
    if not character or not character.Parent then return end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerESP"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(0, 255, 0)
    highlight.FillTransparency = 0.78
    highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PlayerESPLabel"
    billboard.Adornee = rootPart
    billboard.Size = UDim2.fromOffset(200, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = character

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = Color3.fromRGB(50, 255, 50)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Text = player.Name .. " | 0m"
    label.Parent = billboard

    TrackedPlayers[player] = {
        Highlight = highlight,
        Billboard = billboard,
        TextLabel = label,
        Character = character,
        RootPart = rootPart
    }

    PlayerConnections["Ancestry_" .. tostring(player.UserId)] = character.AncestryChanged:Connect(function(_, parent)
        if not parent then DestroyPlayerESP(player) end
    end)
end

local function SetupPlayer(player)
    if player == LocalPlayer then return end
    DisconnectConnection(PlayerConnections, "Character_" .. tostring(player.UserId))

    PlayerConnections["Character_" .. tostring(player.UserId)] = player.CharacterAdded:Connect(function(character)
        if not PlayerEspEnabled then return end
        DestroyPlayerESP(player)

        local rootPart = character:WaitForChild("HumanoidRootPart", 5)
        if not rootPart then return end

        task.defer(function()
            if PlayerEspEnabled and player.Character == character and character.Parent then
                CreatePlayerESP(player)
            end
        end)
    end)

    if player.Character then
        task.defer(function()
            if PlayerEspEnabled then CreatePlayerESP(player) end
        end)
    end
end

local function CleanupPlayers()
    for player, data in pairs(TrackedPlayers) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
    end
    table.clear(TrackedPlayers)

    for key, connection in pairs(PlayerConnections) do
        if string.sub(key, 1, 10) == "Character_" or string.sub(key, 1, 9) == "Ancestry_" then
            connection:Disconnect()
            PlayerConnections[key] = nil
        end
    end
end

local function EnablePlayerESP()
    if PlayerEspEnabled then return end
    PlayerEspEnabled = true

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then SetupPlayer(player) end
    end

    DisconnectConnection(PlayerConnections, "PlayerAdded")
    DisconnectConnection(PlayerConnections, "PlayerRemoving")

    PlayerConnections["PlayerAdded"] = Players.PlayerAdded:Connect(function(player)
        if PlayerEspEnabled then SetupPlayer(player) end
    end)

    PlayerConnections["PlayerRemoving"] = Players.PlayerRemoving:Connect(function(player)
        DestroyPlayerESP(player)
        DisconnectConnection(PlayerConnections, "Character_" .. tostring(player.UserId))
        DisconnectConnection(PlayerConnections, "Ancestry_" .. tostring(player.UserId))
    end)
end

local function DisablePlayerESP()
    if not PlayerEspEnabled then return end
    PlayerEspEnabled = false

    DisconnectConnection(PlayerConnections, "PlayerAdded")
    DisconnectConnection(PlayerConnections, "PlayerRemoving")
    CleanupPlayers()
end

--[====================================================================--
--                       REALTIME LOOP & OPTIMIZATION                 --
--[====================================================================--

local updateTimer = 0
RunService.RenderStepped:Connect(function(dt)
    if not MonsterEspEnabled and not DoorEspEnabled and not KeyEspEnabled and not PlayerEspEnabled then return end

    updateTimer += dt
    if updateTimer >= 0.15 then
        updateTimer = 0
        
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end

        -- Cập nhật Monster ESP
        if MonsterEspEnabled then
            for model, espData in pairs(TrackedMonsters) do
                if model.Parent and espData.TextLabel then
                    local targetPart = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                    if targetPart then
                        local dist = math.floor((rootPart.Position - targetPart.Position).Magnitude)
                        espData.TextLabel.Text = model.Name .. " | " .. dist .. "m"
                    end
                else
                    DestroyMonsterESP(model)
                end
            end
        end

        -- Cập nhật Door ESP
        if DoorEspEnabled then
            for door, espData in pairs(TrackedDoors) do
                if not espData.IsOpened and door.Parent and espData.TextLabel then
                    local targetPart = espData.TargetPart or GetDoorTargetPart(door)
                    if targetPart then
                        local dist = math.floor((rootPart.Position - targetPart.Position).Magnitude)
                        espData.TextLabel.Text = "DOOR | " .. dist .. "m"
                    end
                else
                    DestroyDoorESP(door)
                end
            end
        end

        -- Cập nhật Key ESP
        if KeyEspEnabled then
            for keyObj, espData in pairs(TrackedKeys) do
                if keyObj.Parent and espData.TextLabel then
                    local targetPart = espData.TargetPart or GetKeyTargetPart(keyObj)
                    if targetPart then
                        local dist = math.floor((rootPart.Position - targetPart.Position).Magnitude)
                        espData.TextLabel.Text = "KEY | " .. dist .. "m"
                    end
                else
                    MarkKeyCollected(keyObj)
                end
            end
        end

        -- Cập nhật Player ESP
        if PlayerEspEnabled then
            for player, espData in pairs(TrackedPlayers) do
                if player.Character and player.Character.Parent and espData.TextLabel then
                    local pRoot = espData.RootPart or player.Character:FindFirstChild("HumanoidRootPart")
                    if pRoot then
                        local dist = math.floor((rootPart.Position - pRoot.Position).Magnitude)
                        espData.TextLabel.Text = player.Name .. " | " .. dist .. "m"
                    end
                else
                    DestroyPlayerESP(player)
                end
            end
        end
    end
end)

