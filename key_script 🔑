--========================================================--
-- ANIMATION FUNCTIONS
--========================================================--

local function setAnimation(Object,ID)

    if Object and ID then
        pcall(function()
            Object.AnimationId =
                "rbxassetid://"..tostring(ID)
        end)
    end
end

local function findAnimation(Folder,...)

    if not Folder then
        return nil
    end

    for i=1,select("#",...) do

        local Name = select(i,...)
        local Obj = Folder:FindFirstChild(Name)

        if Obj and Obj:IsA("Animation") then
            return Obj
        end
    end

    return nil
end

local function makeAnimation(Folder,Name)

    if not Folder then
        return nil
    end

    local Obj = Folder:FindFirstChild(Name)

    if not Obj then
        Obj = Instance.new("Animation")
        Obj.Name = Name
        Obj.Parent = Folder
    end

    return Obj
end

local function applyFolder(Animate,FolderName,ID,Names)

    if not ID then
        return
    end

    local Folder =
        Animate:FindFirstChild(FolderName)

    if not Folder then
        return
    end

    local Obj =
        findAnimation(
            Folder,
            table.unpack(Names)
        )

    if not Obj then
        Obj =
            makeAnimation(
                Folder,
                Names[1]
            )
    end

    setAnimation(Obj,ID)
end

local function getAnimate(Character)

    if not Character then
        return nil
    end

    local Animate =
        Character:FindFirstChild("Animate")

    if Animate then
        return Animate
    end

    local Start = os.clock()

    while Character.Parent
    and os.clock()-Start < 8 do

        Animate =
            Character:FindFirstChild("Animate")

        if Animate then
            return Animate
        end

        task.wait(0.1)
    end

    return nil
end

--========================================================--
-- APPLY PACK
--========================================================--

local function applyPack(Name)

    local Pack = PACKS[Name]

    if not Pack then
        return false
    end

    local Character = LP.Character

    if not Character or not Character.Parent then
        return false
    end

    local Animate =
        getAnimate(Character)

    if not Animate then
        return false
    end

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then

        for _,Track in ipairs(
            Humanoid:GetPlayingAnimationTracks()
        ) do
            pcall(function()
                Track:Stop(0)
            end)
        end
    end

    applyFolder(
        Animate,
        "walk",
        Pack.Walk,
        {"WalkAnim","walk","RunAnim"}
    )

    applyFolder(
        Animate,
        "run",
        Pack.Run,
        {"RunAnim","run","WalkAnim"}
    )

    applyFolder(
        Animate,
        "jump",
        Pack.Jump,
        {"JumpAnim","jump"}
    )

    applyFolder(
        Animate,
        "fall",
        Pack.Fall,
        {"FallAnim","fall"}
    )

    applyFolder(
        Animate,
        "climb",
        Pack.Climb,
        {"ClimbAnim","climb"}
    )

    applyFolder(
        Animate,
        "swim",
        Pack.Swim,
        {"Swim","SwimAnim","swim"}
    )

    applyFolder(
        Animate,
        "swimidle",
        Pack.SwimIdle,
        {"SwimIdle","SwimIdleAnim","swimidle"}
    )

    local IdleFolder =
        Animate:FindFirstChild("idle")

    if IdleFolder then

        local Idle1 =
            makeAnimation(
                IdleFolder,
                "Animation1"
            )

        local Idle2 =
            makeAnimation(
                IdleFolder,
                "Animation2"
            )

        if Pack.Idle1 then
            setAnimation(
                Idle1,
                Pack.Idle1
            )
        end

        if Pack.Idle2 then
            setAnimation(
                Idle2,
                Pack.Idle2
            )
        elseif Pack.Idle1 then
            setAnimation(
                Idle2,
                Pack.Idle1
            )
        end
    end

    CurrentPack = Name
    SelectedPack = Name

    pcall(function()
        Animate.Disabled = true
        task.wait(0.05)
        Animate.Disabled = false
    end)

    return true
end

