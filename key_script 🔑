    TweenService:Create(Main, TweenInfo.new(0.3), {Size=UDim2.fromOffset(590,350)}).Completed:Connect(function()
        if not MainOpen then Main.Visible = false; MenuButton.Visible = true end
    end)
end)
Connect(MenuButton.Activated, function() MainOpen = true; Main.Visible = true; MenuButton.Visible = false end)
Connect(Close.Activated, Cleanup)

-- Auto áp lại sau hồi sinh
Connect(Player.CharacterAdded, function()
    task.wait(0.5)
    if CurrentPack then ApplyPack(CurrentPack) end
end)

-- Hiệu ứng viền màu mượt mà
task.spawn(function()
    local hue = 0
    while Alive and Gui.Parent do
        if EffectsEnabled then
            hue = (hue + 0.002) % 1
            MainStroke.Color = Color3.fromHSV(hue, 0.85, 1)
        end
        task.wait(FPS_MODE and 0.1 or 0.05)
    end
end)

