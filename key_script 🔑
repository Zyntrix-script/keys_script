local function DestroyPlayerESP(player)
    local data = TrackedPlayers[player]
    if data then
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        TrackedPlayers[player] = nil
    end
    if player and player.Character then
        CleanupOrphanedInstances(player.Character, "PlayerESP")
    end
end

local function CreatePlayerESP(player)
    if not PlayerEspEnabled or player == LocalPlayer or TrackedPlayers[player] then return end
    local char = player.Character
    if not char or not char.Parent then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerESP"
    highlight.Adornee = char
    highlight.FillColor = Color3.fromRGB(0, 255, 0)
    highlight.FillTransparency = 0.85
    highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PlayerESPLabel"
    billboard.Adornee = rootPart
    billboard.Size = UDim2.fromOffset(160, 30)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = char

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextColor3 = Color3.fromRGB(50, 255, 50)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Text = player.Name .. " | 0m"
    label.Parent = billboard

    TrackedPlayers[player] = { Highlight = highlight, Billboard = billboard, TextLabel = label, RootPart = rootPart }

    ConnectTracked(PlayerConnections, "Ancestry_" .. tostring(player.UserId), char.AncestryChanged:Connect(function(_, parent)
        if not parent then DestroyPlayerESP(player) end
    end))
end

local function SetupPlayer(player)
    if player == LocalPlayer then return end
    DisconnectTracked(PlayerConnections, "Char_" .. tostring(player.UserId))
    ConnectTracked(PlayerConnections, "Char_" .. tostring(player.UserId), player.CharacterAdded:Connect(function(newChar)
        if not PlayerEspEnabled then return end
        DestroyPlayerESP(player)
        local rootPart = newChar:WaitForChild("HumanoidRootPart", 5)
        if rootPart then
            task.defer(function()
                if PlayerEspEnabled then CreatePlayerESP(player) end
            end)
        end
    end))
    if player.Character then
        task.defer(function()
            if PlayerEspEnabled then CreatePlayerESP(player) end
        end)
    end
end

function EnablePlayerESP()
    if PlayerEspEnabled then return end
    PlayerEspEnabled = true
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then SetupPlayer(player) end
    end
    ConnectTracked(PlayerConnections, "PlayerAdded", Players.PlayerAdded:Connect(function(player)
        if PlayerEspEnabled then SetupPlayer(player) end
    end))
    ConnectTracked(PlayerConnections, "PlayerRemoving", Players.PlayerRemoving:Connect(function(player)
        DestroyPlayerESP(player)
        DisconnectTracked(PlayerConnections, "Char_" .. tostring(player.UserId))
    end))
end

function DisablePlayerESP()
    if not PlayerEspEnabled then return end
    PlayerEspEnabled = false
    DisconnectTracked(PlayerConnections, "PlayerAdded")
    DisconnectTracked(PlayerConnections, "PlayerRemoving")
    for player, data in pairs(TrackedPlayers) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        if player and player.Character then CleanupOrphanedInstances(player.Character, "PlayerESP") end
    end
    table.clear(TrackedPlayers)
end

--[====================================================================--
--            SMART DISTANCE LOOP (0.3s THROTTLED + POOLING)          --
--[====================================================================--

task.spawn(function()
    while true do
        task.wait(0.3)
        if MonsterEspEnabled or DoorEspEnabled or KeyEspEnabled or PlayerEspEnabled then
            local char = LocalPlayer.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local pos = rootPart.Position

                if MonsterEspEnabled then
                    for model, esp in pairs(TrackedMonsters) do
                        if model.Parent and esp.TextLabel and esp.TargetPart then
                            local dist = math.floor((pos - esp.TargetPart.Position).Magnitude)
                            if dist <= 300 then
                                esp.Billboard.Enabled = true
                                esp.Highlight.Enabled = true
                                esp.TextLabel.Text = model.Name .. " | " .. dist .. "m"
                            else
                                esp.Billboard.Enabled = false
                                esp.Highlight.Enabled = false
                            end
                        else
                            DestroyMonsterESP(model)
                        end
                    end
                end

                if DoorEspEnabled then
                    for door, esp in pairs(TrackedDoors) do
                        if door.Parent and esp.TextLabel and esp.TargetPart and not IsDoorOpened(door) then
                            local dist = math.floor((pos - esp.TargetPart.Position).Magnitude)
                            if dist <= 300 then
                                esp.Billboard.Enabled = true
                                esp.Highlight.Enabled = true
                                esp.TextLabel.Text = "DOOR | " .. dist .. "m"
                            else
                                esp.Billboard.Enabled = false
                                esp.Highlight.Enabled = false
                            end
                        else
                            DestroyDoorESP(door)
                        end
                    end
                end

                if KeyEspEnabled then
                    for keyObj, esp in pairs(TrackedKeys) do
                        if keyObj.Parent and esp.TextLabel and esp.TargetPart and not CollectedKeysHistory[keyObj] then
                            local dist = math.floor((pos - esp.TargetPart.Position).Magnitude)
                            if dist <= 300 then
                                esp.Billboard.Enabled = true
                                esp.Highlight.Enabled = true
                                esp.TextLabel.Text = "KEY | " .. dist .. "m"
                            else
                                esp.Billboard.Enabled = false
                                esp.Highlight.Enabled = false
                            end
                        else
                            DestroyKeyESP(keyObj)
                        end
                    end
                end

                if PlayerEspEnabled then
                    for player, esp in pairs(TrackedPlayers) do
                        if player.Character and player.Character.Parent and esp.TextLabel and esp.RootPart then
                            local dist = math.floor((pos - esp.RootPart.Position).Magnitude)
                            if dist <= 300 then
                                esp.Billboard.Enabled = true
                                esp.Highlight.Enabled = true
                                esp.TextLabel.Text = player.Name .. " | " .. dist .. "m"
                            else
                                esp.Billboard.Enabled = false
                                esp.Highlight.Enabled = false
                            end
                        else
                            DestroyPlayerESP(player)
                        end
                    end
                end
            end
        end
    end
end)

