local Connections = {}
local Alive = true

local function Connect(signal, callback)

    local c = signal:Connect(callback)

    table.insert(
        Connections,
        c
    )

    return c

end

local function Cleanup()

    Alive = false

    for _, c in ipairs(Connections) do

        pcall(function()
            c:Disconnect()
        end)

    end

    Connections = {}

    pcall(function()

        local a =
            CoreGui:FindFirstChild(
                MAIN_NAME
            )

        if a then
            a:Destroy()
        end

    end)

    pcall(function()

        local b =
            Player.PlayerGui:FindFirstChild(
                MAIN_NAME
            )

        if b then
            b:Destroy()
        end

    end)

end

getgenv().ZYNTRIX_PRIME_V9_CLEANUP =
    Cleanup

