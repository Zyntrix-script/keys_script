local function RenderPacks(filter)
    for _,c in ipairs(Content:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
    local q = string.lower(filter or "")
    for name,pack in pairs(AnimationPacks) do
        if q == "" or string.find(string.lower(name), q, 1, true) then
