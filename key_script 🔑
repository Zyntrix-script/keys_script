--============================================================--

local function ApplyWithRetry(packName)
    if not AnimationPacks[packName] then
        return
    end

    ReapplyToken += 1

    local token = ReapplyToken

    SelectedPack = packName
    ENV.ZYNTRIX_SELECTED_PACK = packName

    task.spawn(function()

        local delays = {
            0,
            0.15,
            0.35,
            0.7,
            1.2,
            2,
            3
        }

        for _, delayTime in ipairs(delays) do

            if token ~= ReapplyToken then
                return
            end

            if delayTime > 0 then
                task.wait(delayTime)
            end

            if token ~= ReapplyToken then
                return
            end

            pcall(function()
                ApplyAnimationPack(packName)
            end)
        end
    end)
end

