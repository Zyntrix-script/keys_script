local function TaoBoGoc(DoiTuong,DoBo)
    local Goc = Instance.new("UICorner")
    Goc.CornerRadius = UDim.new(0,DoBo or 10)
    Goc.Parent = DoiTuong
    return Goc
end

local function TaoVien(DoiTuong,DoDay)
    local Vien = Instance.new("UIStroke")
    Vien.Thickness = DoDay or 1.5
    Vien.Transparency = 0.05
    Vien.Color = MÀU_TÍM
    Vien.Parent = DoiTuong

    task.spawn(function()
        local ThoiGian = 0

        while Vien.Parent do
            ThoiGian += 0.025

            local R = (math.sin(ThoiGian)+1)/2
            local G = (math.sin(ThoiGian+2)+1)/2
            local B = (math.sin(ThoiGian+4)+1)/2

            Vien.Color = Color3.new(R,G,B)

            task.wait()
        end
    end)

    return Vien
end

local function TaoChu(DoiTuong,NoiDung,KichThuoc,Mau)
    local Chu = Instance.new("TextLabel")
    Chu.BackgroundTransparency = 1
    Chu.Text = NoiDung .. " "
    Chu.TextColor3 = Mau or MÀU_TRANG
    Chu.Font = Enum.Font.GothamBold
    Chu.TextSize = KichThuoc or 11
    Chu.TextXAlignment = Enum.TextXAlignment.Left
    Chu.Parent = DoiTuong
    return Chu
end

local function TaoNut(DoiTuong,NoiDung,Mau)
    local Nut = Instance.new("TextButton")
    Nut.BackgroundColor3 = Mau or MÀU_TÍM
    Nut.BackgroundTransparency = 0.05
    Nut.BorderSizePixel = 0
    Nut.Text = NoiDung .. " "
    Nut.TextColor3 = MÀU_TRANG
    Nut.Font = Enum.Font.GothamBold
    Nut.TextSize = 9
    Nut.AutoButtonColor = false
    Nut.Parent = DoiTuong

    TaoBoGoc(Nut,8)
    TaoVien(Nut,1)

    return Nut
end

