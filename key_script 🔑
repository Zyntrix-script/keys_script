local function MakeDraggable(obj, handle)
    local drag, startPos, startOffset
    Connect(handle.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; startPos = i.Position; startOffset = obj.Position
        end
    end)
    Connect(UserInputService.InputChanged, function(i)
        if not drag then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = i.Position - startPos
        obj.Position = UDim2.new(startOffset.X.Scale, startOffset.X.Offset + d.X, startOffset.Y.Scale, startOffset.Y.Offset + d.Y)
    end)
    Connect(handle.InputEnded, function() drag = false end)
end
MakeDraggable(Main, Top)
MakeDraggable(MenuButton, MenuButton)

