--============================================================--
--                    HỆ THỐNG ANIMATION
--============================================================--

local function DatID(DoiTuong,ID)
    if not DoiTuong or not DoiTuong:IsA("Animation") or not ID then
        return
    end

    DoiTuong.AnimationId = "rbxassetid://" .. tostring(ID)
end

local function DatAnimation(Animate,Ten,ID)
    if not ID then
        return
    end

    local Tim = Animate:FindFirstChild(Ten)

    if Tim then

        if Tim:IsA("Animation") then
            DatID(Tim,ID)
            return
        end

        if Tim:IsA("Folder") then
            local Animation = Tim:FindFirstChildWhichIsA("Animation",true)

            if Animation then
                DatID(Animation,ID)
            else
                local AnimationMoi = Instance.new("Animation")
                AnimationMoi.Name = "Animation"
                AnimationMoi.AnimationId = "rbxassetid://" .. tostring(ID)
                AnimationMoi.Parent = Tim
            end

            return
        end
    end

    local TimSau = Animate:FindFirstChild(Ten,true)

    if TimSau and TimSau:IsA("Animation") then
        DatID(TimSau,ID)
    end
end

local function DatIdle(Animate,DuLieu)
    local Idle = Animate:FindFirstChild("idle")

    if not Idle then
        return
    end

    if DuLieu.Idle1 then
        local A1 = Idle:FindFirstChild("Animation1")

        if A1 and A1:IsA("Animation") then
            DatID(A1,DuLieu.Idle1)
        end
    end

    if DuLieu.Idle2 then
        local A2 = Idle:FindFirstChild("Animation2")

        if A2 and A2:IsA("Animation") then
            DatID(A2,DuLieu.Idle2)
        end
    end
end

