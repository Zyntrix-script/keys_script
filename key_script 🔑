--============================================================--
-- ANIMATION FUNCTIONS
--============================================================--

local function GetAnimate()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("Animate")
end

local function SetAnimation(folder, objectName, id)

    if not folder or not id then
        return
    end

    local animation = folder:FindFirstChild(objectName)

    if not animation then
        animation = Instance.new("Animation")
        animation.Name = objectName
        animation.Parent = folder
    end

    animation.AnimationId = "rbxassetid://" .. tostring(id)
end

local function EnsureFolder(parent, name)

    local folder = parent:FindFirstChild(name)

    if not folder then
        folder = Instance.new("Folder")
        folder.Name = name
        folder.Parent = parent
    end

    return folder
end

local function ApplyPack(packName)

    local pack = AnimationPacks[packName]

    if not pack then
        return false
    end

    local character = LocalPlayer.Character

    if not character then
        return false
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local animate = GetAnimate()

    if not humanoid or not animate then
        return false
    end

    if pack.Walk then
        SetAnimation(
            EnsureFolder(animate, "walk"),
            "WalkAnim",
            pack.Walk
        )
    end

    if pack.Run then
        SetAnimation(
            EnsureFolder(animate, "run"),
            "RunAnim",
            pack.Run
        )
    end

    if pack.Jump then
        SetAnimation(
            EnsureFolder(animate, "jump"),
            "JumpAnim",
            pack.Jump
        )
    end

    if pack.Fall then
        SetAnimation(
            EnsureFolder(animate, "fall"),
            "FallAnim",
            pack.Fall
        )
    end

    if pack.Climb then
        SetAnimation(
            EnsureFolder(animate, "climb"),
            "ClimbAnim",
            pack.Climb
        )
    end

    if pack.Swim then
        SetAnimation(
            EnsureFolder(animate, "swim"),
            "Swim",
            pack.Swim
        )
    end

    if pack.SwimIdle then
        SetAnimation(
            EnsureFolder(animate, "swimidle"),
            "SwimIdle",
            pack.SwimIdle
        )
    end

    if pack.Idle1 or pack.Idle2 then

        local idle = EnsureFolder(animate, "idle")

        if pack.Idle1 then
            SetAnimation(
                idle,
                "Animation1",
                pack.Idle1
            )
        end

        if pack.Idle2 then
            SetAnimation(
                idle,
                "Animation2",
                pack.Idle2
            )
        end
    end

    pcall(function()
        animate.Disabled = true
        task.wait()
        animate.Disabled = false
    end)

    return true
end

--============================================================--
-- APPLY RETRY
--============================================================--

local ReapplyToken = 0

local function SelectPack(packName)

    if not AnimationPacks[packName] then
        return
    end

    SelectedPack = packName
    ENV.ZYNTRIX_SELECTED_PACK = packName

    ReapplyToken += 1

    local token = ReapplyToken

    task.spawn(function()

        local retryTimes = {
            0,
            0.15,
            0.35,
            0.7,
            1.2,
            2,
            3
        }

        for _, delayTime in ipairs(retryTimes) do

            if token ~= ReapplyToken then
                return
            end

            if delayTime > 0 then
                task.wait(delayTime)
            end

            if token ~= ReapplyToken then
                return
            end

            pcall(function()
                ApplyPack(packName)
            end)
        end
    end)
end

