--============================================================--
-- TWO COLOR / MOVING TEXT EFFECT
--============================================================--

task.spawn(function()

    local hue = 0
    local offset = 0

    while Gui and Gui.Parent do

        if EffectsEnabled then

            hue += 0.003

            if hue >= 1 then
                hue = 0
            end

            local c1 =
                Color3.fromHSV(hue, 0.85, 1)

            local c2 =
                Color3.fromHSV(
                    (hue + 0.15) % 1,
                    0.85,
                    1
                )

            CurrentA = c1
            CurrentB = c2

            for _, item in ipairs(ColorObjects) do

                if item.Object
                and item.Object.Parent then

                    pcall(function()
                        item.Object[item.Property] = c1
                    end)
                end
            end

            for _, gradient in ipairs(GradientObjects) do

                if gradient
                and gradient.Parent then

                    pcall(function()

                        offset += 0.012

                        if offset > 1 then
                            offset = 0
                        end

                        gradient.Color =
                            ColorSequence.new({
                                ColorSequenceKeypoint.new(
                                    0,
                                    c1
                                ),
                                ColorSequenceKeypoint.new(
                                    0.5,
                                    c2
                                ),
                                ColorSequenceKeypoint.new(
                                    1,
                                    c1
                                )
                            })

                        gradient.Offset =
                            Vector2.new(offset, 0)

                    end)
                end
            end
        end

        task.wait(0.04)
    end
end)

