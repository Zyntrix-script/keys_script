local function GetGamePlayersContainer()
    local gameFolder = Workspace:FindFirstChild("Game")
    if gameFolder then
        return gameFolder:FindFirstChild("GamePlayers")
    end
    return nil
end

local function DestroyMonsterESP(model)
    local data = TrackedMonsters[model]
    if not data then return end
    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end
    TrackedMonsters[model] = nil
end

local function CleanupMonsters()
    DisconnectAll(MonsterConnections)
    for model, data in pairs(TrackedMonsters) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
    end
    table.clear(TrackedMonsters)
end

local function CreateMonsterESP(model)
    if not MonsterEspEnabled or not model or not model:IsA("Model") or TrackedMonsters[model] then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "MonsterESP"
    highlight.Adornee = model
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.75
    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = model

    local targetPart = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MonsterESPLabel"
    billboard.Adornee = targetPart or model
    billboard.Size = UDim2.fromOffset(200, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = model

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = Color3.fromRGB(255, 60, 60)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Text = model.Name .. " | 0m"
    label.Parent = billboard

    TrackedMonsters[model] = { Highlight = highlight, Billboard = billboard, TextLabel = label }

    MonsterConnections["Ancestry_" .. tostring(model)] = model.AncestryChanged:Connect(function(_, parent)
        if not parent then DestroyMonsterESP(model) end
    end)
end

local function ScanMonsters()
    if not MonsterEspEnabled then return end
    local container = GetGamePlayersContainer()
    if not container then return end

    for _, child in ipairs(container:GetChildren()) do
        if MONSTER_NAMES[child.Name] then
            CreateMonsterESP(child)
        end
    end
end

local function EnableMonsterESP()
    if MonsterEspEnabled then return end
    MonsterEspEnabled = true
    ScanMonsters()

    local container = GetGamePlayersContainer()
    if container then
        MonsterConnections["ContainerChildAdded"] = container.ChildAdded:Connect(function(child)
            if not MonsterEspEnabled then return end
            if MONSTER_NAMES[child.Name] then
                task.wait(0.1)
                CreateMonsterESP(child)
            end
        end)
    end
end

local function DisableMonsterESP()
    if not MonsterEspEnabled then return end
    MonsterEspEnabled = false
    CleanupMonsters()
end

--[====================================================================--
--                         DOOR ESP & INTERACTION LOGIC                --
--[====================================================================--

local function DestroyDoorESP(door)
    local data = TrackedDoors[door]
    if not data then return end
    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end
    TrackedDoors[door] = nil
end

local function MarkDoorOpened(door)
    local data = TrackedDoors[door]
    if not data or data.IsOpened then return end
    data.IsOpened = true
    OpenedDoorsHistory[door] = true
    DestroyDoorESP(door)
end

local function IsDoorOpened(door)
    if not door or not door.Parent then return true end
    local attributes = {"Opened", "IsOpened", "Open", "Unlocked", "IsOpen"}
    for _, attributeName in ipairs(attributes) do
        if door:GetAttribute(attributeName) == true then return true end
    end
    local state = door:GetAttribute("State")
    if typeof(state) == "string" then
        local lowered = string.lower(state)
        if lowered == "open" or lowered == "opened" or lowered == "unlocked" then return true end
    end
    local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and not prompt.Enabled then
        if door:GetAttribute("PromptDisabledMeansOpened") == true then return true end
    end
    return false
end

local function GetDoorTargetPart(door)
    if not door then return nil end
    local preferredNames = {"DoorLeft", "DoorRight", "ControlPart", "PrimaryPart"}
    for _, name in ipairs(preferredNames) do
        local obj = door:FindFirstChild(name, true)
        if obj and obj:IsA("BasePart") then return obj end
    end
    if door:IsA("BasePart") then return door end
    return door:FindFirstChildWhichIsA("BasePart", true)
end

local function CreateDoorESP(door)
    if not DoorEspEnabled or not door or not door.Parent then return end
    if TrackedDoors[door] and TrackedDoors[door].Highlight then return end
    if OpenedDoorsHistory[door] then return end

    if IsDoorOpened(door) then
        OpenedDoorsHistory[door] = true
        return
    end

    local targetPart = GetDoorTargetPart(door)
    if not targetPart then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "DoorESP"
    highlight.Adornee = door
    highlight.FillColor = Color3.fromRGB(0, 200, 255)
    highlight.FillTransparency = 0.82
    highlight.OutlineColor = Color3.fromRGB(0, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = door

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DoorESPLabel"
    billboard.Adornee = targetPart
    billboard.Size = UDim2.fromOffset(180, 40)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = door

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = Color3.fromRGB(0, 230, 255)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Text = "DOOR | 0m"
    label.Parent = billboard

    if TrackedDoors[door] then
        TrackedDoors[door].Highlight = highlight
        TrackedDoors[door].Billboard = billboard
        TrackedDoors[door].TextLabel = label
        TrackedDoors[door].TargetPart = targetPart
    else
        TrackedDoors[door] = {
            Highlight = highlight,
            Billboard = billboard,
            TextLabel = label,
            TargetPart = targetPart,
            IsOpened = false
        }
    end

    DoorConnections["Attribute_" .. tostring(door)] = door.AttributeChanged:Connect(function()
        if IsDoorOpened(door) then MarkDoorOpened(door) end
    end)

    DoorConnections["Child_" .. tostring(door)] = door.DescendantAdded:Connect(function()
        task.defer(function()
            if IsDoorOpened(door) then MarkDoorOpened(door) end
        end)
    end)

    DoorConnections["Ancestry_" .. tostring(door)] = door.AncestryChanged:Connect(function(_, parent)
        if not parent then DestroyDoorESP(door) end
    end)
end

local function IsPotentialDoor(obj)
    if not obj then return false end
    local name = string.lower(obj.Name)
    if name == "door" or name == "doorleft" or name == "doorright" or name:find("door", 1, true) then
        return true
    end
    local axisLeft = obj:FindFirstChild("AxisLeft")
    if axisLeft and axisLeft:FindFirstChild("DoorLeft") then return true end
    return false
end

local function ScanDoors()
    local mapsFolder = Workspace:FindFirstChild("Maps")
    if not mapsFolder then return end

    for _, map in ipairs(mapsFolder:GetChildren()) do
        for _, obj in ipairs(map:GetDescendants()) do
            if IsPotentialDoor(obj) then
                local door = obj
                if obj:IsA("BasePart") then door = obj.Parent end
                if door and not OpenedDoorsHistory[door] and not IsDoorOpened(door) then
                    local targetPart = GetDoorTargetPart(door)
                    if targetPart then
                        if not TrackedDoors[door] then
                            TrackedDoors[door] = { TargetPart = targetPart, IsOpened = false }
                        end
                        if DoorEspEnabled then
                            CreateDoorESP(door)
                        end
                    end
                end
            end
        end
    end
end

local function CleanupDoors()
    for door, data in pairs(TrackedDoors) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        data.Highlight = nil
        data.Billboard = nil
        data.TextLabel = nil
    end
    if not AutoFarmEnabled then
        DisconnectAll(DoorConnections)
        table.clear(TrackedDoors)
    end
end

local function EnableDoorESP()
    if DoorEspEnabled then return end
    DoorEspEnabled = true
    ScanDoors()
    for door, _ in pairs(TrackedDoors) do
        CreateDoorESP(door)
    end

    local mapsFolder = Workspace:FindFirstChild("Maps")
    if mapsFolder then
        MapConnections["DoorDescendantAdded"] = mapsFolder.DescendantAdded:Connect(function(obj)
            if not DoorEspEnabled then return end
            task.defer(function()
                if IsPotentialDoor(obj) then
                    local door = obj
                    if obj:IsA("BasePart") then door = obj.Parent end
                    if door then 
                        local targetPart = GetDoorTargetPart(door)
                        if targetPart then
                            if not TrackedDoors[door] then
                                TrackedDoors[door] = { TargetPart = targetPart, IsOpened = false }
                            end
                            CreateDoorESP(door)
                        end
                    end
                end
            end)
        end)
    end
end

local function DisableDoorESP()
    if not DoorEspEnabled then return end
    DoorEspEnabled = false
    for door, data in pairs(TrackedDoors) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        data.Highlight = nil
        data.Billboard = nil
        data.TextLabel = nil
    end
    if not AutoFarmEnabled then
        CleanupDoors()
    end
end

--[====================================================================--
--                   KEY ESP & AUTO FARM LOGIC                         --
--[====================================================================--

local function DestroyKeyESP(keyObj)
    local data = TrackedKeys[keyObj]
    if not data then return end
    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end
    TrackedKeys[keyObj] = nil
end

local function MarkKeyCollected(keyObj)
    local data = TrackedKeys[keyObj]
    if not data then return end
    CollectedKeysHistory[keyObj] = true
    DestroyKeyESP(keyObj)
end

local function IsKeyObject(obj)
    if not obj then return false end
    local name = obj.Name
    if name == "Meshes/suo_LOCK01" or name == "Meshes/suo_LOCK02" then
        return true
    end
    local fullName = obj:GetFullName()
    if string.find(fullName, "Meshes/suo_LOCK01") or string.find(fullName, "Meshes/suo_LOCK02") then
        return true
    end
    return false
end

local function GetKeyTargetPart(keyObj)
    if not keyObj then return nil end
    if keyObj:IsA("BasePart") then return keyObj end
    return keyObj:FindFirstChildWhichIsA("BasePart", true)
end

local function CreateKeyESP(keyObj)
    if not keyObj or not keyObj.Parent then return end
    if TrackedKeys[keyObj] and TrackedKeys[keyObj].Highlight then return end
    if CollectedKeysHistory[keyObj] then return end

    local targetPart = GetKeyTargetPart(keyObj)
    if not targetPart then return end

    local highlight, billboard, label
    if KeyEspEnabled then
        highlight = Instance.new("Highlight")
        highlight.Name = "KeyESP"
        highlight.Adornee = keyObj
        highlight.FillColor = Color3.fromRGB(255, 220, 0)
        highlight.FillTransparency = 0.75
        highlight.OutlineColor = Color3.fromRGB(255, 255, 100)
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = keyObj

        billboard = Instance.new("BillboardGui")
        billboard.Name = "KeyESPLabel"
        billboard.Adornee = targetPart
        billboard.Size = UDim2.fromOffset(180, 40)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = keyObj

        label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextSize = 13
        label.TextColor3 = Color3.fromRGB(255, 235, 50)
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextStrokeTransparency = 0
        label.Text = "KEY | 0m"
        label.Parent = billboard
    end

    if TrackedKeys[keyObj] then
        TrackedKeys[keyObj].Highlight = highlight
        TrackedKeys[keyObj].Billboard = billboard
        TrackedKeys[keyObj].TextLabel = label
        TrackedKeys[keyObj].TargetPart = targetPart
    else
        TrackedKeys[keyObj] = {
            Highlight = highlight,
            Billboard = billboard,
            TextLabel = label,
            TargetPart = targetPart
        }
    end

    KeyConnections["Ancestry_" .. tostring(keyObj)] = keyObj.AncestryChanged:Connect(function(_, parent)
        if not parent then MarkKeyCollected(keyObj) end
    end)
end

local function ScanKeys()
    local mapsFolder = Workspace:FindFirstChild("Maps")
    if not mapsFolder then return end

    for _, map in ipairs(mapsFolder:GetChildren()) do
        for _, descendant in ipairs(map:GetDescendants()) do
            if IsKeyObject(descendant) then
                local targetPart = GetKeyTargetPart(descendant)
                if targetPart then
                    if not TrackedKeys[descendant] then
                        TrackedKeys[descendant] = { TargetPart = targetPart }
                    end
                    if KeyEspEnabled then
                        CreateKeyESP(descendant)
                    end
                end
            end
        end
    end
end

local function CleanupKeys()
    for keyObj, data in pairs(TrackedKeys) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
    end
    if not AutoFarmEnabled then
        DisconnectAll(KeyConnections)
        table.clear(TrackedKeys)
        table.clear(CollectedKeysHistory)
    end
end

local function EnableKeyESP()
    if KeyEspEnabled then return end
    KeyEspEnabled = true
    ScanKeys()
    for keyObj, _ in pairs(TrackedKeys) do
