--                       ÁP DỤNG PACK
--============================================================--

local function ApDungGoi(TenGoi)
    local DuLieu = GoiHoatHinh[TenGoi]

    if not DuLieu then
        return false
    end

    local NhanVat = NguoiChoi.Character

    if not NhanVat then
        return false
    end

    local Humanoid = NhanVat:FindFirstChildOfClass("Humanoid")
    local Animate = NhanVat:FindFirstChild("Animate")

    if not Humanoid or not Animate then
        return false
    end

    -- Dừng animation cũ
    pcall(function()
        for _,Track in ipairs(Humanoid:GetPlayingAnimationTracks()) do
            Track:Stop(0.05)
        end
    end)

    -- Gán animation
    DatAnimation(Animate,"walk",DuLieu.Walk)
    DatAnimation(Animate,"run",DuLieu.Run)
    DatAnimation(Animate,"jump",DuLieu.Jump)
    DatAnimation(Animate,"fall",DuLieu.Fall)
    DatAnimation(Animate,"climb",DuLieu.Climb)
    DatAnimation(Animate,"swim",DuLieu.Swim)
    DatAnimation(Animate,"swimidle",DuLieu.SwimIdle)

    DatIdle(Animate,DuLieu)

    -- Lưu pack đang dùng
    GoiDangChon = TenGoi

    -- Khởi động lại hệ thống Animate
    pcall(function()
        Animate.Disabled = true
        task.wait()
        Animate.Disabled = false
    end)

    return true
end

