    local character = GetCharacter()

    if not character then
        return nil
    end

    local animate = character:FindFirstChild("Animate")

    if animate then
        return animate
    end

    return nil
end

local function ApplyAnimationPack(packName)
    local pack = AnimationPacks[packName]

    if not pack then
        return false
    end

    local character = GetCharacter()

    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local animate = character:FindFirstChild("Animate")

    if not humanoid or not animate then
        return false
    end

    -- WALK
    if pack.Walk then
        local walk = animate:FindFirstChild("walk")
        if not walk then
            walk = Instance.new("Folder")
            walk.Name = "walk"
            walk.Parent = animate
        end

        SetAnimation(walk, "WalkAnim", pack.Walk)
    end

    -- RUN
    if pack.Run then
        local run = animate:FindFirstChild("run")
        if not run then
            run = Instance.new("Folder")
            run.Name = "run"
            run.Parent = animate
        end

        SetAnimation(run, "RunAnim", pack.Run)
    end

    -- JUMP
    if pack.Jump then
        local jump = animate:FindFirstChild("jump")
        if not jump then
            jump = Instance.new("Folder")
            jump.Name = "jump"
            jump.Parent = animate
        end

        SetAnimation(jump, "JumpAnim", pack.Jump)
    end

    -- FALL
    if pack.Fall then
        local fall = animate:FindFirstChild("fall")
        if not fall then
            fall = Instance.new("Folder")
            fall.Name = "fall"
            fall.Parent = animate
        end

        SetAnimation(fall, "FallAnim", pack.Fall)
    end

    -- CLIMB
    if pack.Climb then
        local climb = animate:FindFirstChild("climb")
        if not climb then
            climb = Instance.new("Folder")
            climb.Name = "climb"
            climb.Parent = animate
        end

        SetAnimation(climb, "ClimbAnim", pack.Climb)
    end

    -- SWIM
    if pack.Swim then
        local swim = animate:FindFirstChild("swim")
        if not swim then
            swim = Instance.new("Folder")
            swim.Name = "swim"
            swim.Parent = animate
        end

        SetAnimation(swim, "Swim", pack.Swim)
    end

    -- SWIM IDLE
    if pack.SwimIdle then
        local swimIdle = animate:FindFirstChild("swimidle")
        if not swimIdle then
            swimIdle = Instance.new("Folder")
            swimIdle.Name = "swimidle"
            swimIdle.Parent = animate
        end

        SetAnimation(swimIdle, "SwimIdle", pack.SwimIdle)
    end

    -- IDLE
    if pack.Idle1 or pack.Idle2 then
        local idle = animate:FindFirstChild("idle")

        if not idle then
            idle = Instance.new("Folder")
            idle.Name = "idle"
            idle.Parent = animate
        end

        if pack.Idle1 then
            SetAnimation(idle, "Animation1", pack.Idle1)
        end

        if pack.Idle2 then
            SetAnimation(idle, "Animation2", pack.Idle2)
        end
    end

    -- RESTART ANIMATE
    pcall(function()
        animate.Disabled = true
        task.wait()
        animate.Disabled = false
    end)

    return true
end

