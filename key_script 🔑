local function ConnectTracked(tableRef, key, connection)
    if tableRef[key] then
        tableRef[key]:Disconnect()
    end
    tableRef[key] = connection
end

local function DisconnectTracked(tableRef, key)
    if tableRef[key] then
        tableRef[key]:Disconnect()
        tableRef[key] = nil
    end
end

local function DisconnectAll(tableRef)
    for key, conn in pairs(tableRef) do
        if conn then
            conn:Disconnect()
        end
        tableRef[key] = nil
    end
end

-- Hàm hỗ trợ dọn dẹp triệt để các Instance ESP còn sót lại theo Name
local function CleanupOrphanedInstances(parentInstance, espName)
    if not parentInstance then return end
    pcall(function()
        for _, descendant in ipairs(parentInstance:GetDescendants()) do
            if descendant.Name == espName or descendant.Name == (espName .. "Label") then
                descendant:Destroy()
            end
        end
    end)
end

