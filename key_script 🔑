--========================================================--
-- TEXT SHINE ENGINE
-- MỌI TEXTLABEL / TEXTBUTTON / TEXTBOX
--========================================================--

local ShineObjects = {}

local function AddTextShine(Object)

    if not Object:IsA("TextLabel")
    and not Object:IsA("TextButton")
    and not Object:IsA("TextBox") then
        return
    end

    if Object:GetAttribute("TextShine") then
        return
    end

    Object:SetAttribute("TextShine",true)

    local Gradient = Instance.new("UIGradient")
    Gradient.Name = "TextShine"
    Gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,WHITE),
        ColorSequenceKeypoint.new(0.35,WHITE),
        ColorSequenceKeypoint.new(0.47,CYAN),
        ColorSequenceKeypoint.new(0.50,WHITE),
        ColorSequenceKeypoint.new(0.53,CYAN),
        ColorSequenceKeypoint.new(0.65,WHITE),
        ColorSequenceKeypoint.new(1,WHITE)
    })

    Gradient.Rotation = 20
    Gradient.Offset = Vector2.new(-1.2,0)
    Gradient.Parent = Object

    table.insert(ShineObjects,{
        Object = Object,
        Gradient = Gradient
    })
end

local function RegisterAllText()

    for _,Object in ipairs(GUI:GetDescendants()) do
        AddTextShine(Object)
    end
end

GUI.DescendantAdded:Connect(function(Object)

    task.defer(function()
        AddTextShine(Object)
    end)
end)

