local function GetGamePlayersContainer()
    local gameFolder = Workspace:FindFirstChild("Game")
    if gameFolder then
        return gameFolder:FindFirstChild("GamePlayers")
    end
    return nil
end

local function DestroyMonsterESP(model)
    local data = TrackedMonsters[model]
    if data then
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        TrackedMonsters[model] = nil
    end
    if model then
        CleanupOrphanedInstances(model, "MonsterESP")
    end
end

local function CleanupMonsters()
    DisconnectAll(MonsterConnections)
    for model, data in pairs(TrackedMonsters) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        if model then CleanupOrphanedInstances(model, "MonsterESP") end
    end
    table.clear(TrackedMonsters)
    local container = GetGamePlayersContainer()
    if container then
        for _, child in ipairs(container:GetChildren()) do
            CleanupOrphanedInstances(child, "MonsterESP")
        end
    end
end

local function CreateMonsterESP(model)
    if not MonsterEspEnabled or not model or not model:IsA("Model") then return end
    if TrackedMonsters[model] then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "MonsterESP"
    highlight.Adornee = model
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.8
    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = model

    local targetPart = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MonsterESPLabel"
    billboard.Adornee = targetPart or model
    billboard.Size = UDim2.fromOffset(160, 30)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = model

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextColor3 = Color3.fromRGB(255, 60, 60)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Text = model.Name .. " | 0m"
    label.Parent = billboard

    TrackedMonsters[model] = { Highlight = highlight, Billboard = billboard, TextLabel = label, TargetPart = targetPart }

    ConnectTracked(MonsterConnections, "Ancestry_" .. tostring(model), model.AncestryChanged:Connect(function(_, parent)
        if not parent then DestroyMonsterESP(model) end
    end))
end

function EnableMonsterESP()
    if MonsterEspEnabled then return end
    MonsterEspEnabled = true
    local container = GetGamePlayersContainer()
    if container then
        for _, child in ipairs(container:GetChildren()) do
            if MONSTER_NAMES[child.Name] then
                CreateMonsterESP(child)
            end
        end
        ConnectTracked(MonsterConnections, "ContainerChildAdded", container.ChildAdded:Connect(function(child)
            if not MonsterEspEnabled then return end
            if MONSTER_NAMES[child.Name] then
                task.wait(0.1)
                if MonsterEspEnabled then
                    CreateMonsterESP(child)
                end
            end
        end))
    end
end

function DisableMonsterESP()
    if not MonsterEspEnabled then return end
    MonsterEspEnabled = false
    CleanupMonsters()
end

--[====================================================================--
--                         DOOR ESP LOGIC                              --
--[====================================================================--

local function DestroyDoorESP(door)
    local data = TrackedDoors[door]
    if data then
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        TrackedDoors[door] = nil
    end
    if door then
        CleanupOrphanedInstances(door, "DoorESP")
    end
end

local function IsDoorOpened(door)
    if not door or not door.Parent then return true end
    if door:GetAttribute("Opened") == true or door:GetAttribute("IsOpened") == true or door:GetAttribute("Open") == true then return true end
    local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and not prompt.Enabled then return true end
    return false
end

local function GetDoorTargetPart(door)
    if not door then return nil end
    local preferredNames = {"DoorLeft", "DoorRight", "ControlPart", "PrimaryPart"}
    for _, name in ipairs(preferredNames) do
        local obj = door:FindFirstChild(name, true)
        if obj and obj:IsA("BasePart") then return obj end
    end
    if door:IsA("BasePart") then return door end
    return door:FindFirstChildWhichIsA("BasePart", true)
end

local function CreateDoorESP(door)
    if not DoorEspEnabled or not door or not door.Parent then return end
    if TrackedDoors[door] and TrackedDoors[door].Highlight then return end
    if OpenedDoorsHistory[door] or IsDoorOpened(door) then
        OpenedDoorsHistory[door] = true
        return
    end

    local targetPart = GetDoorTargetPart(door)
    if not targetPart then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "DoorESP"
    highlight.Adornee = door
    highlight.FillColor = Color3.fromRGB(0, 180, 255)
    highlight.FillTransparency = 0.85
    highlight.OutlineColor = Color3.fromRGB(0, 220, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = door

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DoorESPLabel"
    billboard.Adornee = targetPart
    billboard.Size = UDim2.fromOffset(160, 30)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = door

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextColor3 = Color3.fromRGB(0, 220, 255)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Text = "DOOR | 0m"
    label.Parent = billboard

    TrackedDoors[door] = {
        Highlight = highlight,
        Billboard = billboard,
        TextLabel = label,
        TargetPart = targetPart
    }

    ConnectTracked(DoorConnections, "Attr_" .. tostring(door), door.AttributeChanged:Connect(function()
        if IsDoorOpened(door) then
            OpenedDoorsHistory[door] = true
            DestroyDoorESP(door)
        end
    end))
    ConnectTracked(DoorConnections, "Ancestry_" .. tostring(door), door.AncestryChanged:Connect(function(_, parent)
        if not parent then DestroyDoorESP(door) end
    end))
end

local function ScanDoors()
    local mapsFolder = Workspace:FindFirstChild("Maps")
    if not mapsFolder then return end

    for _, map in ipairs(mapsFolder:GetChildren()) do
        for _, obj in ipairs(map:GetDescendants()) do
            local name = string.lower(obj.Name)
            if name == "door" or name == "doorleft" or name == "doorright" or name:find("door", 1, true) then
                local door = obj:IsA("BasePart") and obj.Parent or obj
                if door then
                    local targetPart = GetDoorTargetPart(door)
                    if targetPart then
                        if not TrackedDoors[door] then
                            TrackedDoors[door] = { TargetPart = targetPart }
                        elseif not TrackedDoors[door].TargetPart then
                            TrackedDoors[door].TargetPart = targetPart
                        end
                    end
                end
            end
        end
    end
end

function EnableDoorESP()
    if DoorEspEnabled then return end
    DoorEspEnabled = true
    ScanDoors()
    for door, _ in pairs(TrackedDoors) do
        if DoorEspEnabled then
            CreateDoorESP(door)
        end
    end
    local mapsFolder = Workspace:FindFirstChild("Maps")
    if mapsFolder then
        ConnectTracked(MapConnections, "DoorDescendantAdded", mapsFolder.DescendantAdded:Connect(function(obj)
            if not DoorEspEnabled then return end
            task.defer(function()
                if not DoorEspEnabled then return end
                local name = string.lower(obj.Name)
                if name == "door" or name == "doorleft" or name == "doorright" then
                    local door = obj:IsA("BasePart") and obj.Parent or obj
                    if door then
                        local targetPart = GetDoorTargetPart(door)
                        if targetPart then
                            if not TrackedDoors[door] then
                                TrackedDoors[door] = { TargetPart = targetPart }
                            else
                                TrackedDoors[door].TargetPart = targetPart
                            end
                            if DoorEspEnabled then
                                CreateDoorESP(door)
                            end
                        end
                    end
                end
            end)
        end))
    end
end

function DisableDoorESP()
    if not DoorEspEnabled then return end
    DoorEspEnabled = false
    for door, data in pairs(TrackedDoors) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        if door then CleanupOrphanedInstances(door, "DoorESP") end
    end
    table.clear(TrackedDoors)
    DisconnectTracked(MapConnections, "DoorDescendantAdded")
end

--[====================================================================--
--                         KEY ESP LOGIC                               --
--[====================================================================--

local function DestroyKeyESP(keyObj)
    local data = TrackedKeys[keyObj]
    if data then
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        TrackedKeys[keyObj] = nil
    end
    if keyObj then
        CleanupOrphanedInstances(keyObj, "KeyESP")
    end
end

local function IsKeyObject(obj)
    if not obj then return false end
    local name = obj.Name
    if name == "Meshes/suo_LOCK01" or name == "Meshes/suo_LOCK02" then return true end
    local fullName = obj:GetFullName()
    if string.find(fullName, "Meshes/suo_LOCK01") or string.find(fullName, "Meshes/suo_LOCK02") then return true end
    return false
end

local function GetKeyTargetPart(keyObj)
    if not keyObj then return nil end
    if keyObj:IsA("BasePart") then return keyObj end
    return keyObj:FindFirstChildWhichIsA("BasePart", true)
end

local function CreateKeyESP(keyObj)
    if not KeyEspEnabled or not keyObj or not keyObj.Parent then return end
    if TrackedKeys[keyObj] and TrackedKeys[keyObj].Highlight then return end
    if CollectedKeysHistory[keyObj] then return end

    local targetPart = GetKeyTargetPart(keyObj)
    if not targetPart then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "KeyESP"
    highlight.Adornee = keyObj
    highlight.FillColor = Color3.fromRGB(255, 220, 0)
    highlight.FillTransparency = 0.8
    highlight.OutlineColor = Color3.fromRGB(255, 255, 100)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = keyObj

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "KeyESPLabel"
    billboard.Adornee = targetPart
    billboard.Size = UDim2.fromOffset(160, 30)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = keyObj

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextColor3 = Color3.fromRGB(255, 235, 50)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Text = "KEY | 0m"
    label.Parent = billboard

    TrackedKeys[keyObj] = {
        Highlight = highlight,
        Billboard = billboard,
        TextLabel = label,
        TargetPart = targetPart
    }

    ConnectTracked(KeyConnections, "Ancestry_" .. tostring(keyObj), keyObj.AncestryChanged:Connect(function(_, parent)
        if not parent then
            CollectedKeysHistory[keyObj] = true
            DestroyKeyESP(keyObj)
        end
    end))
end

local function ScanKeys()
    local mapsFolder = Workspace:FindFirstChild("Maps")
    if not mapsFolder then return end

    for _, map in ipairs(mapsFolder:GetChildren()) do
        for _, descendant in ipairs(map:GetDescendants()) do
            if IsKeyObject(descendant) then
                local targetPart = GetKeyTargetPart(descendant)
                if targetPart then
                    if not TrackedKeys[descendant] then
                        TrackedKeys[descendant] = { TargetPart = targetPart }
                    elseif not TrackedKeys[descendant].TargetPart then
                        TrackedKeys[descendant].TargetPart = targetPart
                    end
                end
            end
        end
    end
end

function EnableKeyESP()
    if KeyEspEnabled then return end
    KeyEspEnabled = true
    ScanKeys()
    for keyObj, _ in pairs(TrackedKeys) do
        if KeyEspEnabled then
            CreateKeyESP(keyObj)
        end
    end
    local mapsFolder = Workspace:FindFirstChild("Maps")
    if mapsFolder then
        ConnectTracked(MapConnections, "KeyDescendantAdded", mapsFolder.DescendantAdded:Connect(function(descendant)
            if not KeyEspEnabled then return end
            task.defer(function()
                if not KeyEspEnabled then return end
                if IsKeyObject(descendant) then
                    local targetPart = GetKeyTargetPart(descendant)
                    if targetPart then
                        if not TrackedKeys[descendant] then
                            TrackedKeys[descendant] = { TargetPart = targetPart }
                        else
                            TrackedKeys[descendant].TargetPart = targetPart
                        end
                        if KeyEspEnabled then
                            CreateKeyESP(descendant)
                        end
                    end
                end
            end)
        end))
    end
end

function DisableKeyESP()
    if not KeyEspEnabled then return end
    KeyEspEnabled = false
    for keyObj, data in pairs(TrackedKeys) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        if keyObj then CleanupOrphanedInstances(keyObj, "KeyESP") end
    end
    table.clear(TrackedKeys)
    DisconnectTracked(MapConnections, "KeyDescendantAdded")
end

