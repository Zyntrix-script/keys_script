-- Hàm kiểm tra xem nhân vật có đang cầm key hay vật phẩm nào trên tay không hoặc kiểm tra balo
local function CharacterHoldsKey()
    local char = LocalPlayer.Character
    if not char then return false end
    -- Kiểm tra xem có Tool nào đang được equip trên nhân vật không
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            local name = string.lower(child.Name)
            if name:find("key") or name:find("lock") or name:find("suo") then
                return true
            end
        end
    end
    return false
end

-- Hàm tương tác nhanh và tự động bấm ProximityPrompt khi Teleport tới nơi
local function FastInteractAtPosition(targetPart)
    if not targetPart or not targetPart.Parent then return end
    
    -- Kích hoạt mọi ProximityPrompt gần targetPart
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parentPart = obj.Parent
            if parentPart and parentPart:IsA("BasePart") then
                if (targetPart.Position - parentPart.Position).Magnitude <= 15 then
                    pcall(function()
                        fireproximityprompt(obj)
                    end)
                end
            end
        end
    end

    local prompt = targetPart:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt and targetPart.Parent then
        prompt = targetPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    if prompt then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end

    local clickDet = targetPart:FindFirstChildWhichIsA("ClickDetector", true)
    if clickDet then
        pcall(function()
            fireclickdetector(clickDet)
        end)
    end

    pcall(function()
        firetouchinterest(targetPart, LocalPlayer.Character.HumanoidRootPart, 0)
        task.wait(0.05)
        firetouchinterest(targetPart, LocalPlayer.Character.HumanoidRootPart, 1)
    end)
end

-- Vòng lặp Auto Farm hoàn chỉnh theo yêu cầu: Lấy Key -> Random mở cửa -> Kiểm tra nhân vật đang cầm -> Tele về cửa và tự động tương tác nhanh
task.spawn(function()
    while true do
        if AutoFarmEnabled then
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                ScanKeys()
                ScanDoors()

                -- 1. Lấy danh sách Key chưa nhặt
                local availableKeys = {}
                for keyObj, data in pairs(TrackedKeys) do
                    if keyObj.Parent and not CollectedKeysHistory[keyObj] then
                        local part = data.TargetPart or GetKeyTargetPart(keyObj)
                        if part and part.Parent then
                            table.insert(availableKeys, {Obj = keyObj, Part = part})
                        end
                    end
                end

                -- 2. Lấy danh sách Cửa chưa mở
                local availableDoors = {}
                for door, data in pairs(TrackedDoors) do
                    if not data.IsOpened and not OpenedDoorsHistory[door] and not IsDoorOpened(door) then
                        local part = data.TargetPart or GetDoorTargetPart(door)
                        if part and part.Parent then
                            table.insert(availableDoors, {Obj = door, Part = part})
                        end
                    end
                end

                -- Xử lý logic: Nếu chưa cầm key/item thì đi lấy key ngẫu nhiên, ngược lại (hoặc nếu có key) thì mở cửa ngẫu nhiên và tele lại tương tác nhanh
                if #availableKeys > 0 and not CharacterHoldsKey() then
                    local randomKeyData = availableKeys[math.random(1, #availableKeys)]
                    if randomKeyData and randomKeyData.Part and randomKeyData.Part.Parent then
                        rootPart.CFrame = CFrame.new(randomKeyData.Part.Position + Vector3.new(0, 3, 0))
                        task.wait(0.2)
                        FastInteractAtPosition(randomKeyData.Part)
                        task.wait(0.3)
                        if not randomKeyData.Part.Parent then
                            MarkKeyCollected(randomKeyData.Obj)
                        end
                    end
                elseif #availableDoors > 0 then
                    local randomDoorData = availableDoors[math.random(1, #availableDoors)]
                    if randomDoorData and randomDoorData.Part and randomDoorData.Part.Parent then
                        rootPart.CFrame = CFrame.new(randomDoorData.Part.Position + Vector3.new(0, 3, 0))
                        task.wait(0.2)
                        FastInteractAtPosition(randomDoorData.Part)
                        task.wait(0.3)
                        if IsDoorOpened(randomDoorData.Obj) then
                            MarkDoorOpened(randomDoorData.Obj)
                        end
                    end
                else
                    task.wait(0.5)
                end
            else
                task.wait(1)
            end
        else
            task.wait(0.5)
        end
    end
end)

