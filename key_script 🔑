local function AnimationObject(parent, name, animationId)
    local object = parent:FindFirstChild(name)

    if not object then
        object = Instance.new("Animation")
        object.Name = name
        object.Parent = parent
    end

    object.AnimationId = "rbxassetid://" .. tostring(animationId)

    return object
end

local function SetAnimation(container, name, animationId)
    if not container or not animationId then
        return
    end

    local object = container:FindFirstChild(name)

    if not object then
        object = Instance.new("Animation")
        object.Name = name
        object.Parent = container
    end

    object.AnimationId = "rbxassetid://" .. tostring(animationId)
end

