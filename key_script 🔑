local CurrentMap = nil

local function ResetRoundData()
    if not DoorEspEnabled then 
        DisconnectAll(DoorConnections)
        table.clear(TrackedDoors)
    end
    if not KeyEspEnabled then 
        DisconnectAll(KeyConnections)
        table.clear(TrackedKeys)
    end
    table.clear(OpenedDoorsHistory)
    table.clear(CollectedKeysHistory)

    if PlayerEspEnabled then
        CleanupPlayers()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then SetupPlayer(player) end
        end
    end

    if MonsterEspEnabled then
        CleanupMonsters()
    end
end

local function SetupMapWatcher()
    local mapsFolder = Workspace:FindFirstChild("Maps")
    if not mapsFolder then return end

    MapConnections["MapAdded"] = mapsFolder.ChildAdded:Connect(function(newMap)
        task.wait(0.25)
        if CurrentMap ~= newMap then
            CurrentMap = newMap
            ResetRoundData()
            task.wait(0.5)
            ScanDoors()
            ScanKeys()
            if DoorEspEnabled then
                for door, _ in pairs(TrackedDoors) do CreateDoorESP(door) end
            end
            if KeyEspEnabled then
                for keyObj, _ in pairs(TrackedKeys) do CreateKeyESP(keyObj) end
            end
            if MonsterEspEnabled then ScanMonsters() end
        end
    end)

    MapConnections["MapRemoved"] = mapsFolder.ChildRemoved:Connect(function(oldMap)
        if oldMap == CurrentMap then
            CurrentMap = nil
            ResetRoundData()
            task.wait(0.25)
            local newMaps = mapsFolder:GetChildren()
            if #newMaps > 0 then
                CurrentMap = newMaps[1]
                ScanDoors()
                ScanKeys()
                if DoorEspEnabled then
                    for door, _ in pairs(TrackedDoors) do CreateDoorESP(door) end
                end
                if KeyEspEnabled then
                    for keyObj, _ in pairs(TrackedKeys) do CreateKeyESP(keyObj) end
                end
                if MonsterEspEnabled then ScanMonsters() end
            end
        end
    end)

    local existingMaps = mapsFolder:GetChildren()
    if #existingMaps > 0 then
        CurrentMap = existingMaps[1]
    end
end

SetupMapWatcher()

