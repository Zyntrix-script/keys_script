local function AddToggleButton(name, defaultState, callback)
    local Slot = Instance.new("Frame", Container)
    Slot.Size = UDim2.new(1, 0, 0, 42)
    Slot.BackgroundColor3 = Color3.fromRGB(20, 25, 35)
    Slot.BorderSizePixel = 0
    Instance.new("UICorner", Slot).CornerRadius = CornerRadius

    local Btn = Instance.new("TextButton", Slot)
    Btn.Size = UDim2.new(1, -16, 1, -8)
    Btn.Position = UDim2.new(0, 8, 0, 4)
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = 13
    Instance.new("UICorner", Btn).CornerRadius = CornerRadius

    local state = defaultState
    local function updateVisual()
        if state then
            Btn.Text = name .. ": ON"
            Btn.BackgroundColor3 = Color3.fromRGB(0, 100, 140)
            Btn.TextColor3 = Color3.new(1, 1, 1)
        else
            Btn.Text = name .. ": OFF"
            Btn.BackgroundColor3 = Color3.fromRGB(40, 50, 70)
            Btn.TextColor3 = Color3.fromRGB(180, 200, 220)
        end
    end
    updateVisual()

    Btn.MouseButton1Click:Connect(function()
        state = not state
        updateVisual()
        pcall(function()
            callback(state)
        end)
    end)

    return Slot
end

