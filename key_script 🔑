local CurrentPack, ApplyToken = nil, 0

local function GetAnimate()
    local c = Player.Character; if not c then return nil end
    local a = c:FindFirstChild("Animate") or c:WaitForChild("Animate", 3)
    return a
end

local function SetAnim(parent, name, id)
    if not id then return end
    local anim = parent:FindFirstChild(name) or MakeGui("Animation", {Name=name}, parent)
    pcall(function() anim.AnimationId = "rbxassetid://"..tostring(id) end)
end

local function ApplyPack(packName)
    local pack = AnimationPacks[packName]; if not pack then return end
    CurrentPack = packName; ApplyToken += 1
    Status.Text = "ĐANG ÁP DỤNG: "..packName
    task.spawn(function()
        for _,delay in ipairs({0, 0.15, 0.35, 0.7, 1.2, 2}) do
            if ApplyToken ~= ApplyToken or not Alive then return end
            if delay > 0 then task.wait(delay) end
            local a = GetAnimate(); if not a then continue end
            pcall(function()
                if a:FindFirstChild("walk") then SetAnim(a.walk, "WalkAnim", pack.Walk) end
                if a:FindFirstChild("run") then SetAnim(a.run, "RunAnim", pack.Run) end
                if a:FindFirstChild("jump") then SetAnim(a.jump, "JumpAnim", pack.Jump) end
                if a:FindFirstChild("fall") then SetAnim(a.fall, "FallAnim", pack.Fall) end
                if a:FindFirstChild("climb") then SetAnim(a.climb, "ClimbAnim", pack.Climb) end
                if a:FindFirstChild("swim") then SetAnim(a.swim, "Swim", pack.Swim) end
                if a:FindFirstChild("swimidle") then SetAnim(a.swimidle, "SwimIdle", pack.SwimIdle or pack.SwimIdle) end
                if a:FindFirstChild("idle") then
                    SetAnim(a.idle, "Animation1", pack.Idle1 or pack.Idle)
                    SetAnim(a.idle, "Animation2", pack.Idle2)
                end
            end)
            Status.Text = "✅ ĐÃ ÁP DỤNG: "..packName
            return
        end
        Status.Text = "⚠️ THỬ LẠI SAU NHA"
    end)
end

